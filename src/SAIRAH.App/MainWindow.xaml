<Window x:Class="SAIRAH.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SAIRAH.App.ViewModels"
        Title="SAIRAH Assistant"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="14"
                Background="#1F2937">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="SAIRAH"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Secure Artificial Intelligence Responsive Assistant Hub"
                               Foreground="#9CA3AF"
                               FontSize="13"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="#374151"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding AssistantStatus}"
                               Foreground="#D1D5DB"
                               FontSize="12"/>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16"
                Padding="12"
                CornerRadius="14"
                Background="#030712">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    CornerRadius="10"
                                    Background="#1F2937">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}"
                                               Foreground="#93C5FD"
                                               FontWeight="Bold"
                                               FontSize="13"/>

                                    <TextBlock Text="{Binding Message}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                     Height="44"
                     FontSize="15"
                     Padding="12"
                     VerticalContentAlignment="Center"
                     Background="#1F2937"
                     Foreground="White"
                     BorderBrush="#374151"
                     CaretBrush="White"/>

            <Button Grid.Column="1"
                    Content="Run"
                    Height="44"
                    Margin="12,0,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Command="{Binding SendCommandCommand}"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
  